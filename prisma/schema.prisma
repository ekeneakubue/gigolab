// Gigolab — tenants (companies) and members (users).
// Set `DATABASE_URL` in `.env` (see https://pris.ly/d/prisma-schema#accessing-environment-variables).

generator client {
  provider = "prisma-client-js"
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}

enum AccountStatus {
  Active
  Trial
  Inactive
}


enum CompanyPlan {
  Base
  Ascent
  Summit
  Pinnacle
}

/// Matches app roles. Spaced names are display labels stored via `@map`.
enum UserRole {
  Admin
  Manager
  Staff
  LabManager       @map("Lab Manager")
  LabOwner         @map("Lab Owner")
  LabTechnician    @map("Lab Technician")
  LabReceptionist  @map("Lab Receptionist")
  LabHR            @map("Lab HR")
  Supervisor
  Receptionist
  Technician
}

model Company {
  id            String         @id @default(cuid())
  /// Login identifier, e.g. Gigolab-A1b2C3
  code          String         @unique
  passwordHash  String
  name          String
  initials      String
  location      String
  plan          CompanyPlan    @default(Base)
  status        AccountStatus  @default(Active)
  contactEmail  String
  phone         String?
  joinedAt      DateTime       @default(now())
  lastActiveAt  DateTime?
  /// Denormalised for dashboards; can be maintained by app logic or jobs.
  userCount     Int            @default(0)
  sampleCount   Int            @default(0)
  logoUrl       String?
  /// Hex brand color used for company theming, e.g. #059669
  brandColor    String         @default("#059669")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users                User[]
  roles                CompanyRole[]
  patients             Patient[]
  ageGroups            AgeGroup[]
  departments          Department[]
  doctors              Doctor[]
  tests                Test[]
  packages             Package[]
  sampleRegistrations  SampleRegistration[]
  testRequests         TestRequest[]
  insuranceTypes       InsuranceType[]
  appointments         Appointment[]
  features             CompanyFeature[]
  branches             Branch[]

  @@index([status])
  @@map("companies")
}

/// Lab branch / collection centre under a company.
model Branch {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String
  location  String        @default("")
  address   String        @default("")
  phone     String        @default("")
  email     String        @default("")
  isMain    Boolean       @default(false)
  status    AccountStatus @default(Active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users User[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@map("branches")
}

/// Features enabled for a company (admin Edit Company entitlements).
model CompanyFeature {
  companyId String
  featureId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feature   AppFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([companyId, featureId])
  @@index([featureId])
  @@map("company_features")
}

model User {
  id           String         @id @default(cuid())
  companyId    String?
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyRoleId String?
  companyRole  CompanyRole?   @relation(fields: [companyRoleId], references: [id], onDelete: SetNull)
  branchId     String?
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)

  email        String         @unique
  name         String
  initials     String
  role         UserRole
  status       AccountStatus  @default(Active)
  accessLabel  String         @default("Tests limited")

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastSeenAt   DateTime?

  passwordHash String?
  imageUrl     String?

  @@index([companyId])
  @@index([companyRoleId])
  @@index([branchId])
  @@index([status])
  @@map("users")
}

model Patient {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patientCode       String
  name              String
  email             String        @default("")
  phone             String        @default("")
  gender            String        @default("")
  dateOfBirth       DateTime?
  address           String        @default("")
  hasInsurance      Boolean       @default(false)
  insuranceProvider String        @default("")
  insuranceNumber   String        @default("")
  insurancePlan     String        @default("")
  status            AccountStatus @default(Active)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  testRequests      TestRequest[]
  appointments      Appointment[]

  @@unique([companyId, patientCode])
  @@index([companyId])
  @@index([email])
  @@index([status])
  @@map("patients")
}

/// Custom lab role with a private dashboard route assigned on login.
model CompanyRole {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  description    String   @default("")
  /// e.g. /company/dashboards/lab-technician
  dashboardRoute String
  permissionKeys String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users User[]

  @@unique([companyId, name])
  @@unique([companyId, dashboardRoute])
  @@index([companyId])
  @@map("company_roles")
}

/// Platform / admin roles (mirrors company roles: route + feature permissions).
model SystemRole {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String   @default("")
  /// e.g. /admin or /admin/dashboards/manager
  dashboardRoute String   @unique
  /// Admin | Lab — admin portal vs lab-facing system roles
  kind           String   @default("Lab")
  permissionKeys String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([kind])
  @@map("system_roles")
}

model AgeGroup {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  fromYears    Int       @default(0)
  fromMonths   Int       @default(0)
  fromDays     Int       @default(0)
  toYears      Int       @default(0)
  toMonths     Int       @default(0)
  toDays       Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId])
  @@map("age_groups")
}

model Department {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  accountName    String          @default("")
  firmName       String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  subDepartments SubDepartment[]
  tests          Test[]

  @@index([companyId])
  @@map("departments")
}

model SubDepartment {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tests        Test[]

  @@index([departmentId])
  @@map("sub_departments")
}

model Doctor {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  email           String   @default("")
  mobile          String   @default("")
  clinicAddress   String   @default("")
  qualification   String   @default("")
  specialization  String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sampleRegistrations SampleRegistration[]
  testRequests        TestRequest[]

  @@index([companyId])
  @@map("doctors")
}

enum DoneFor {
  Male
  Female
  Both
}

model Test {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  printAs         String         @default("")
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subDepartmentId String?
  subDepartment   SubDepartment? @relation(fields: [subDepartmentId], references: [id], onDelete: SetNull)
  amount          Float
  testMrp         Float
  doneFor         DoneFor        @default(Both)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  registrationTests SampleRegistrationTest[]
  testRequestItems  TestRequestItem[]

  @@index([companyId])
  @@index([departmentId])
  @@index([subDepartmentId])
  @@map("tests")
}

model SampleRegistration {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sampleCode     String
  sampleName     String
  category       String
  age            String
  doctorId       String
  doctor         Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patientId      String
  sampleType     String
  collectionDate DateTime
  registeredAt   DateTime
  tests          SampleRegistrationTest[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, sampleCode])
  @@index([companyId])
  @@index([doctorId])
  @@map("sample_registrations")
}

model SampleRegistrationTest {
  id             String             @id @default(cuid())
  registrationId String
  registration   SampleRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  testId         String
  test           Test               @relation(fields: [testId], references: [id], onDelete: Restrict)
  result         String             @default("")
  normalRange    String             @default("")
  sortOrder      Int                @default(0)

  @@index([registrationId])
  @@index([testId])
  @@map("sample_registration_tests")
}

model Package {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@map("packages")
}

enum TestRequestStatus {
  Pending
  InProgress
  Completed
}

enum TestRequestPriority {
  Routine
  Urgent
  STAT
}

enum TestRequestPaymentStatus {
  Unpaid
  Partial
  Paid
}

/// Diagnostic order created from Diagnostics → Test Requests.
model TestRequest {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestCode   String
  /// Unique scan token printed as barcode / used on /results/[token]
  barcodeToken  String              @unique @default(cuid())
  patientId     String
  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId      String?
  doctor        Doctor?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  priority      TestRequestPriority @default(Routine)
  sampleType    String
  clinicalNotes String              @default("")
  status        TestRequestStatus   @default(Pending)
  requestedAt   DateTime
  totalAmount   Float               @default(0)
  paymentStatus TestRequestPaymentStatus @default(Unpaid)
  paymentMethod String              @default("")
  amountPaid    Float               @default(0)
  paymentRef    String              @default("")
  paidAt        DateTime?
  /// Set from Check Test Result after review — unlocks public QR lookup
  resultsReleased Boolean           @default(false)
  verifiedAt    DateTime?
  items         TestRequestItem[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([companyId, requestCode])
  @@index([companyId])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([paymentStatus])
  @@index([resultsReleased])
  @@index([requestedAt])
  @@map("test_requests")
}

model TestRequestItem {
  id          String      @id @default(cuid())
  requestId   String
  request     TestRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  testId      String
  test        Test        @relation(fields: [testId], references: [id], onDelete: Restrict)
  /// Snapshot of catalogue amount at request time
  amount      Float
  result      String      @default("")
  normalRange String      @default("")
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([requestId])
  @@index([testId])
  @@map("test_request_items")
}

enum AppointmentStatus {
  Pending
  Confirmed
  Cancelled
  Completed
}

model Appointment {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  reason      String
  notes       String            @default("")
  status      AppointmentStatus @default(Pending)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([companyId])
  @@index([patientId])
  @@index([status])
  @@index([scheduledAt])
  @@map("appointments")
}

/// Catalogue of insurance type categories for a company (e.g. HMO, NHIS, Corporate).
model InsuranceType {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  code        String        @default("")
  description String        @default("")
  status      AccountStatus @default(Active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
  @@map("insurance_types")
}

enum AppFeatureType {
  Page
  Menu
}

enum AppFeatureStatus {
  Active
  Inactive
}

/// Platform sidebar feature managed from `/admin/app-features`.
model AppFeature {
  id          String           @id @default(cuid())
  name        String
  route       String           @unique
  type        AppFeatureType   @default(Page)
  status      AppFeatureStatus @default(Active)
  description String           @default("")
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  modules   AppFeatureModule[]
  companies CompanyFeature[]

  @@index([status])
  @@index([sortOrder])
  @@map("app_features")
}

enum DemoApplicationStatus {
  Pending
  Contacted
  Approved
  Rejected
}

/// Public "Apply for Demo" submissions from the marketing site.
model DemoApplication {
  id           String                 @id @default(cuid())
  labName      String
  location     String
  contactEmail String
  phone        String                 @default("")
  logoUrl      String?
  status       DemoApplicationStatus  @default(Pending)
  notes        String                 @default("")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([status])
  @@index([contactEmail])
  @@index([createdAt])
  @@map("demo_applications")
}

/// Nested submenu tree for an `AppFeature` (unlimited depth via parent/children).
model AppFeatureModule {
  id        String             @id @default(cuid())
  featureId String
  feature   AppFeature         @relation(fields: [featureId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    AppFeatureModule?  @relation("AppFeatureModuleTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  AppFeatureModule[] @relation("AppFeatureModuleTree")
  label     String
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([featureId])
  @@index([parentId])
  @@index([sortOrder])
  @@map("app_feature_modules")
}
