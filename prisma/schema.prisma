// Gigolab — tenants (companies) and members (users).
// Set `DATABASE_URL` in `.env` (see https://pris.ly/d/prisma-schema#accessing-environment-variables).

generator client {
  provider = "prisma-client-js"
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}

enum AccountStatus {
  Active
  Trial
  Inactive
}


enum CompanyPlan {
  Base
  Ascent
  Summit
  Pinnacle
}

/// Matches app roles. Spaced names are display labels stored via `@map`.
enum UserRole {
  Admin
  Manager
  Staff
  LabManager       @map("Lab Manager")
  LabOwner         @map("Lab Owner")
  LabTechnician    @map("Lab Technician")
  LabReceptionist  @map("Lab Receptionist")
  LabHR            @map("Lab HR")
  Supervisor
  Receptionist
  Technician
}

model Company {
  id            String         @id @default(cuid())
  /// Login identifier, e.g. Gigolab-A1b2C3
  code          String         @unique
  passwordHash  String
  name          String
  initials      String
  location      String
  plan          CompanyPlan    @default(Base)
  status        AccountStatus  @default(Active)
  contactEmail  String
  phone         String?
  joinedAt      DateTime       @default(now())
  lastActiveAt  DateTime?
  /// Denormalised for dashboards; can be maintained by app logic or jobs.
  userCount     Int            @default(0)
  sampleCount   Int            @default(0)
  logoUrl       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users                User[]
  ageGroups            AgeGroup[]
  departments          Department[]
  doctors              Doctor[]
  tests                Test[]
  packages             Package[]
  sampleRegistrations  SampleRegistration[]

  @@index([status])
  @@map("companies")
}

model User {
  id           String         @id @default(cuid())
  companyId    String?
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  email        String         @unique
  name         String
  initials     String
  role         UserRole
  status       AccountStatus  @default(Active)
  accessLabel  String         @default("Tests limited")

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastSeenAt   DateTime?

  passwordHash String?
  imageUrl     String?

  @@index([companyId])
  @@index([status])
  @@map("users")
}

model AgeGroup {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  fromYears    Int       @default(0)
  fromMonths   Int       @default(0)
  fromDays     Int       @default(0)
  toYears      Int       @default(0)
  toMonths     Int       @default(0)
  toDays       Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId])
  @@map("age_groups")
}

model Department {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  accountName    String          @default("")
  firmName       String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  subDepartments SubDepartment[]
  tests          Test[]

  @@index([companyId])
  @@map("departments")
}

model SubDepartment {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tests        Test[]

  @@index([departmentId])
  @@map("sub_departments")
}

model Doctor {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  email           String   @default("")
  mobile          String   @default("")
  clinicAddress   String   @default("")
  qualification   String   @default("")
  specialization  String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sampleRegistrations SampleRegistration[]

  @@index([companyId])
  @@map("doctors")
}

enum DoneFor {
  Male
  Female
  Both
}

model Test {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  printAs         String         @default("")
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subDepartmentId String?
  subDepartment   SubDepartment? @relation(fields: [subDepartmentId], references: [id], onDelete: SetNull)
  amount          Float
  testMrp         Float
  doneFor         DoneFor        @default(Both)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  registrationTests SampleRegistrationTest[]

  @@index([companyId])
  @@index([departmentId])
  @@index([subDepartmentId])
  @@map("tests")
}

model SampleRegistration {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sampleCode     String
  sampleName     String
  category       String
  age            String
  doctorId       String
  doctor         Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patientId      String
  sampleType     String
  collectionDate DateTime
  registeredAt   DateTime
  tests          SampleRegistrationTest[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, sampleCode])
  @@index([companyId])
  @@index([doctorId])
  @@map("sample_registrations")
}

model SampleRegistrationTest {
  id             String             @id @default(cuid())
  registrationId String
  registration   SampleRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  testId         String
  test           Test               @relation(fields: [testId], references: [id], onDelete: Restrict)
  result         String             @default("")
  normalRange    String             @default("")
  sortOrder      Int                @default(0)

  @@index([registrationId])
  @@index([testId])
  @@map("sample_registration_tests")
}

model Package {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@map("packages")
}
